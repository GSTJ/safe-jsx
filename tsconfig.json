{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "lib": ["ES2020"],
    "types": ["node", "jest"],
    "outDir": "lib",
    "rootDir": "src"
  },
  "exclude": ["node_modules", "src/**/*.test.ts", "src/**/*.test.tsx"]
}
