{
  "name": "eslint-plugin-safe-jsx",
  "version": "2.0.0",
  "description": "An ESLint plugin that enforces explicit boolean conversion before using && operator with JSX in React and React Native.",
  "keywords": [
    "boolean",
    "code quality",
    "coding standards",
    "conversion",
    "eslint",
    "eslint-plugin",
    "javascript",
    "jsx",
    "linting",
    "react",
    "react-native"
  ],
  "homepage": "https://github.com/GSTJ/safe-jsx#readme",
  "bugs": "https://github.com/GSTJ/safe-jsx/issues",
  "license": "MIT",
  "author": "Gabriel Taveira",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GSTJ/safe-jsx.git"
  },
  "files": [
    "CHANGELOG.md",
    "SECURITY.md",
    "lib"
  ],
  "main": "lib/index.js",
  "scripts": {
    "prepack": "npm run build",
    "build": "rimraf lib && tsc -p tsconfig.build.json",
    "lint": "oxlint --report-unused-disable-directives",
    "lint:fix": "oxlint --report-unused-disable-directives --fix",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "typecheck": "tsc --noEmit",
    "test": "jest --coverage && node tools/release-check.mjs && node tools/security-check.mjs",
    "prepublish": "not-in-publish || npm run prepublishOnly",
    "prepublishOnly": "safe-publish-latest && npm run lint && npm run test",
    "changelog": "node tools/changelog.mjs",
    "changelog:check": "node tools/changelog-check.mjs",
    "release-notes": "node tools/release-notes.mjs",
    "release:check": "node tools/release-check.mjs",
    "release:tag": "node tools/tag-release.mjs",
    "version": "npm run changelog && git add CHANGELOG.md",
    "postversion": "npm run release:tag",
    "security:check": "node tools/security-check.mjs",
    "audit": "node tools/security-audit.mjs"
  },
  "devDependencies": {
    "@types/estree": "^1.0.9",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@typescript-eslint/parser": "^8.70.0",
    "conventional-changelog": "^8.1.0",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "conventional-recommended-bump": "^12.1.0",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "magic-codemods": "^1.1.0",
    "magic-oxfmt-config": "^1.2.0",
    "magic-oxlint-config": "^3.0.0",
    "magic-tsconfig": "^1.2.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "rimraf": "^6.1.3",
    "safe-publish-latest": "^2.0.0",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "eslint": "^3 || ^4 || ^5 || ^6 || ^7 || ^8 || ^9 || ^10"
  },
  "peerDependenciesMeta": {
    "eslint": {
      "optional": true
    }
  },
  "jest": {
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "lcov",
      "json",
      "html"
    ],
    "preset": "ts-jest",
    "roots": [
      "src"
    ],
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=14.0"
  },
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1"
}
